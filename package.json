  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "developer-tools",
    "utilities",
    "browser",
    "typescript",
    "zero-dependencies",
    "pastebin",
    "ansi-color",
    "xpath",
    "css-selector",
    "email-extractor",
    "hex-view",
    "html-preview",
    "keycode",
    "lua-validator",
    "raw-file-view",
    "stack-trace-parser"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-esm.mjs && node scripts/smoke-cjs.cjs",
    "test:consumer": "node scripts/verify-tarball.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/browser": "^3.0.7",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^9.21.0",
    "playwright": "^1.50.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}