{
  "name": "@rahul_dadhich15/developer-utilities-toolkit",
  "version": "0.1.0",
  "description": "Zero-dependency, browser-first developer utilities toolkit for modern web applications and developer tools.",
  "author": "Rahul Dadhich",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahul_dadhich15/developer-utilities-toolkit.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
